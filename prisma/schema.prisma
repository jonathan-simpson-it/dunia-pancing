generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  logo      String?
  address   String   @default("")
  phone     String   @default("")
  kaApiKey  String?
  xenditKey String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  products   Product[]
  categories Category[]
  orders     Order[]
  vouchers      Voucher[]
  conversations Conversation[]
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  password      String?
  name          String?
  phone         String?
  role          String    @default("client")
  emailVerified DateTime?
  image         String?
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id])

  accounts Account[]
  sessions Session[]
  orders   Order[]
  reviews  Review[]
  addresses UserAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id     String @id @default(cuid())
  key    String
  nameId String
  nameEn String
  icon   String?
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  products Product[]

  @@unique([key, shopId])
}

model Product {
  id                   String   @id @default(cuid())
  nameId               String
  nameEn               String
  descriptionId        String?
  descriptionEn        String?
  category             String   @default("")
  brand                String   @default("")
  specifications       String   @default("[]")
  priceIdr             Float
  originalPriceIdr     Float?
  inStock              Boolean  @default(true)
  soldCount            Int      @default(0)
  rating               Float    @default(0)
  location             String   @default("")
  image                String?
  images               String   @default("[]")
  weight               Float    @default(0)
  stockQty             Int      @default(0)
  keyFeatures          String   @default("[]")
  features             String   @default("[]")
  wishlistCount        Int      @default(0)
  shippingEstimateMin  Int      @default(2)
  shippingEstimateMax  Int      @default(5)
  slug                 String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shopId      String
  shop        Shop       @relation(fields: [shopId], references: [id])
  categoryId  String?
  categoryRel Category?  @relation(fields: [categoryId], references: [id])

  variantTypes     VariantType[]
  productVariants  ProductVariant[]
  sizeChartEntries SizeChartEntry[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([shopId])
  @@index([slug])
}

model VariantType {
  id        String @id @default(cuid())
  name      String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values VariantValue[]

  @@index([productId])
}

model VariantValue {
  id            String @id @default(cuid())
  label         String
  metadata      String?
  variantTypeId String
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)

  @@index([variantTypeId])
}

model ProductVariant {
  id               String  @id @default(cuid())
  sku              String?
  combination      String
  priceIdr         Float
  originalPriceIdr Float?
  stockQty         Int     @default(0)
  weight           Float?
  image            String?
  images           String?
  measurements     String?
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SizeChartEntry {
  id        String @id @default(cuid())
  label     String
  values    String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  status          String   @default("waiting_payment")
  customerName    String
  customerPhone   String
  customerAddress String?
  customerCity    String?
  customerNote    String?
  subtotal        Float
  shippingFee     Float    @default(0)
  shippingLabel   String?
  discount        Float    @default(0)
  total           Float
  paymentMethod   String?
  paymentType     String?
  paymentBank     String?
  paymentId       String?
  courier         String?
  courierLabel    String?
  awbNumber       String?
  awbPrinted      Boolean  @default(false)
  pickupType      String?
  pickupWindow    String?
  cancelNote      String?
  shippedAt       String?
  deliveredAt     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  items         OrderItem[]
  statusHistory StatusHistory[]

  @@index([shopId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  nameId       String
  nameEn       String
  image        String?
  priceIdr     Float
  qty          Int
  variantId    String?
  variantLabel String?

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model StatusHistory {
  id        String   @id @default(cuid())
  status    String
  timestamp DateTime @default(now())
  note      String?

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Voucher {
  id          String   @id @default(cuid())
  code        String
  type        String
  value       Float
  minSpend    Float?
  maxUses     Int?
  currentUses Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([code, shopId])
  @@index([shopId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  text      String?
  images    String   @default("[]")
  isApproved Boolean @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}

model Conversation {
  id            String   @id @default(cuid())
  customerName  String?
  customerPhone String?
  sessionId     String   @unique
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]

  @@index([shopId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  text           String
  sender         String   @default("user")
  read           Boolean  @default(false)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model UserAddress {
  id        String   @id @default(cuid())
  label     String
  name      String
  phone     String
  address   String
  city      String   @default("Palembang")
  isDefault Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
